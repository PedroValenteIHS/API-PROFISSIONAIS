generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PerfilUsuario {
  PACIENTE
  PROFISSIONAL
  RECEPCAO
}

enum StatusAgendamento {
  AGENDADO
  REALIZADO
  CANCELADO
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String        @db.VarChar(120)
  email        String        @unique @db.VarChar(160)
  senhaHash    String        @map("senha_hash") @db.VarChar(255)
  perfil       PerfilUsuario
  criadoEm     DateTime      @default(now()) @map("criado_em")
  paciente     Paciente?
  profissional Profissional?

  @@map("usuarios")
}

model Paciente {
  id             Int           @id @default(autoincrement())
  usuarioId      Int           @unique @map("usuario_id")
  cpf            String        @unique @db.VarChar(11)
  telefone       String?       @db.VarChar(20)
  dataNascimento DateTime?     @map("data_nascimento") @db.Date
  usuario        Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  agendamentos   Agendamento[]

  @@map("pacientes")
}

model Especialidade {
  id             Int            @id @default(autoincrement())
  nome           String         @unique @db.VarChar(100)
  profissionais  Profissional[]

  @@map("especialidades")
}

model Profissional {
  id               Int               @id @default(autoincrement())
  usuarioId        Int               @unique @map("usuario_id")
  especialidadeId Int               @map("especialidade_id")
  crm              String            @unique @db.VarChar(30)
  usuario          Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  especialidade    Especialidade     @relation(fields: [especialidadeId], references: [id], onDelete: Restrict)
  disponibilidades Disponibilidade[]
  agendamentos     Agendamento[]

  @@index([especialidadeId])
  @@map("profissionais")
}

model Disponibilidade {
  id             Int          @id @default(autoincrement())
  profissionalId Int          @map("profissional_id")
  inicio         DateTime
  fim            DateTime
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([profissionalId, inicio])
  @@map("disponibilidades")
}

model Agendamento {
  id              Int               @id @default(autoincrement())
  pacienteId      Int               @map("paciente_id")
  profissionalId  Int               @map("profissional_id")
  dataHora        DateTime          @map("data_hora")
  status          StatusAgendamento @default(AGENDADO)
  criadoEm        DateTime          @default(now()) @map("criado_em")
  canceladoEm     DateTime?         @map("cancelado_em")
  paciente        Paciente          @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  profissional    Profissional      @relation(fields: [profissionalId], references: [id], onDelete: Restrict)

  avaliacao       Avaliacao?

  // o unique de profissional + horario so vale pros AGENDADO, por isso fica
  // direto no sql da migration (o prisma nao escreve indice com where)
  @@index([pacienteId, dataHora])
  @@map("agendamentos")
}

model Avaliacao {
  id            Int         @id @default(autoincrement())
  agendamentoId Int         @unique @map("agendamento_id")
  nota          Int
  comentario    String?     @db.VarChar(1000)
  criadoEm      DateTime    @default(now()) @map("criado_em")
  atualizadoEm  DateTime    @updatedAt @map("atualizado_em")
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Restrict)

  @@map("avaliacoes")
}
